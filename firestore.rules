rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── Global Helper Functions ──────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Safely reads the original role of a user before the update
    function getUserRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    // ── Users Collection ─────────────────────────────────────────────────────
    match /users/{userId} {
      // Read access: allow authenticated users. Prevent leaking sensitive fields in client apps.
      allow read: if signedIn();
      
      // Creation: user must set themselves as a student, not admin.
      allow create: if signedIn() && isOwner(userId) && 
        request.resource.data.role == 'student';
        
      // Update: Prevent role alteration (privilege escalation) & immutable field tampering
      allow update: if signedIn() && (
        isAdmin() || (
          isOwner(userId) && 
          !request.resource.data.diff(resource.data).changedKeys().hasAny(['role', 'createdAt', 'email'])
        ) || (
          // Allow connection increment only if changed by exactly 1
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['connectionsCount']) &&
          (request.resource.data.connectionsCount == resource.data.connectionsCount + 1 ||
           request.resource.data.connectionsCount == resource.data.connectionsCount - 1)
        ) || (
          // Allow followersCount to be updated by any signed-in user (when someone follows/unfollows)
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['followersCount']) &&
          (request.resource.data.followersCount == resource.data.followersCount + 1 ||
           request.resource.data.followersCount == resource.data.followersCount - 1)
        ) || (
          // Allow followingCount to be updated by the owner only
          isOwner(userId) &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['followingCount']) &&
          (request.resource.data.followingCount == resource.data.followingCount + 1 ||
           request.resource.data.followingCount == resource.data.followingCount - 1)
        )
      );

      allow delete: if isAdmin();

      // User Certificates
      match /certificates/{certId} {
        allow read: if signedIn() && (isOwner(userId) || isAdmin());
        allow write: if isOwner(userId) || isAdmin();
      }

      // Connections: Owner can manage their own connections.
      // Also allow the connected user to create/delete entries (needed during accept flow
      // where user A must write to user B's /connections subcollection and vice versa).
      match /connections/{connectedUserId} {
        allow read: if signedIn() && (isOwner(userId) || isOwner(connectedUserId) || isAdmin());
        // Owner manages their list, OR the connected user creates/removes the symmetric entry
        allow write: if signedIn() && (isOwner(userId) || isOwner(connectedUserId) || isAdmin());
      }

      // Incoming connection requests: Sender writes, recipient approves (deletes)
      match /incomingConnectionRequests/{fromUserId} {
        allow read: if signedIn() && (isOwner(userId) || isOwner(fromUserId) || isAdmin());
        // Must represent a real request from the authenticated sender
        allow create: if signedIn() && request.auth.uid == fromUserId;
        // Only sender or receiver can delete/cancel/ignore
        allow delete: if signedIn() && (isOwner(userId) || isOwner(fromUserId) || isAdmin());
      }

      // Outgoing connection requests
      match /outgoingConnectionRequests/{toUserId} {
        allow read: if signedIn() && (isOwner(userId) || isOwner(toUserId) || isAdmin());
        allow create: if signedIn() && isOwner(userId);
        allow delete: if signedIn() && (isOwner(userId) || isOwner(toUserId) || isAdmin());
      }
    }

    // ── Posts Collection ─────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if signedIn();
      
      allow create: if signedIn() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.likesCount == 0 &&
        request.resource.data.commentsCount == 0;

      allow update: if signedIn() && (
        isAdmin() ||
        isOwner(resource.data.userId) ||
        (
          // Allow community interaction increments, validating they only change by exactly +1 / -1
          request.resource.data.diff(resource.data).changedKeys().hasAny([
            'likedBy', 'laughedBy', 'supportedBy', 'likesCount', 'laughedCount', 'supportedCount', 'commentsCount'
          ]) &&
          // Enforce strict increment constraints on likesCount
          (request.resource.data.likesCount == resource.data.likesCount + 1 ||
           request.resource.data.likesCount == resource.data.likesCount - 1 ||
           request.resource.data.likesCount == resource.data.likesCount) &&
          // Validate commentsCount increment
          (request.resource.data.commentsCount == resource.data.commentsCount + 1 ||
           request.resource.data.commentsCount == resource.data.commentsCount - 1 ||
           request.resource.data.commentsCount == resource.data.commentsCount)
        )
      );

      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ── Followers Collection ─────────────────────────────────────────────────
    // Doc ID format: {followerId}_{followingId}
    match /followers/{followDocId} {
      // Any signed-in user can read (to check follow status)
      allow read: if signedIn();

      // Only the follower themselves can create a follow document
      allow create: if signedIn() &&
        request.resource.data.followerId == request.auth.uid &&
        request.resource.data.followingId != request.auth.uid;

      // Only the follower themselves can delete (unfollow)
      allow delete: if signedIn() &&
        resource.data.followerId == request.auth.uid;
    }

    // ── Comments Collection ──────────────────────────────────────────────────
    match /comments/{commentId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      
      allow update: if signedIn() && (
        isOwner(resource.data.userId) ||
        (
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['likedBy', 'likesCount', 'repliesCount']) &&
          (request.resource.data.likesCount == resource.data.likesCount + 1 ||
           request.resource.data.likesCount == resource.data.likesCount - 1 ||
           request.resource.data.likesCount == resource.data.likesCount)
        )
      );

      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ── Notifications Collection ──────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if signedIn() && (resource.data.toUserId == request.auth.uid || isAdmin());
      
      // Ensure users can only send notifications originating from their own ID
      allow create: if signedIn() && 
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.read == false;

      // Allow recipient to mark it read, and allow original sender to update/resend
      allow update: if signedIn() && (
        isAdmin() ||
        (
          resource.data.toUserId == request.auth.uid &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['read', 'updatedAt'])
        ) ||
        resource.data.fromUserId == request.auth.uid
      );

      allow delete: if isAdmin() || resource.data.toUserId == request.auth.uid;
    }

    // ── Broadcasts & Schedules ───────────────────────────────────────────────
    match /broadcasts/{broadcastId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    
    match /schedules/{scheduleId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ── Communities System ───────────────────────────────────────────────────
    match /communities/{communityId} {
      
      function getMemberRole() {
        return get(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.role;
      }

      function memberExists() {
        return exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
      }

      function isCommunityMember() {
        return signedIn() && memberExists();
      }

      function isCommunityAdmin() {
        return signedIn() && memberExists() &&
          (getMemberRole() == 'admin' || getMemberRole() == 'superAdmin');
      }

      function isCommunityCreator() {
        return signedIn() && resource.data.createdBy == request.auth.uid;
      }

      allow get: if signedIn() && (
        resource.data.isPublic == true ||
        isCommunityCreator() ||
        isCommunityMember()
      );

      allow list: if signedIn();

      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;

      allow update: if signedIn() && (
        isCommunityAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'description', 'imageUrl', 'isPublic', 'inviteLink'
        ])
      );

      allow delete: if isCommunityCreator();

      match /members/{memberId} {
        allow read: if signedIn() && (isCommunityMember() || memberId == request.auth.uid);
        allow write: if isCommunityAdmin();
        allow create: if signedIn() && memberId == request.auth.uid && (
          request.resource.data.role == 'member' ||
          (
            request.resource.data.role == 'superAdmin' &&
            getAfter(/databases/$(database)/documents/communities/$(communityId)).data.createdBy == request.auth.uid
          )
        );
        allow delete: if signedIn() && memberId == request.auth.uid;
      }

      match /joinRequests/{requestId} {
        allow read: if isCommunityAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
        allow create: if signedIn() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.status == 'pending';
        allow update: if isCommunityAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
        allow delete: if isCommunityAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      }
    }

    // ── Chat Groups ──────────────────────────────────────────────────────────
    match /groups/{groupId} {
      function isGroupMember() {
        return signedIn() && request.auth.uid in resource.data.memberIds;
      }
      function isGroupAdmin() {
        return signedIn() && (
          request.auth.uid in resource.data.adminIds ||
          request.auth.uid == resource.data.ownerId
        );
      }
      function isGroupOwner() {
        return signedIn() && request.auth.uid == resource.data.ownerId;
      }

      allow get, list: if signedIn();
      
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.auth.uid in request.resource.data.memberIds;

      function isJoiningGroup() {
        let diff = request.resource.data.diff(resource.data);
        let addingSelf = request.resource.data.memberIds.hasAll(resource.data.memberIds) 
                         && (request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1)
                         && (request.auth.uid in request.resource.data.memberIds);
        // Secure Join: Direct self-joining is ONLY allowed if the group is set to public (isPublic == true)
        return diff.affectedKeys().hasOnly(['memberIds', 'activeMembers', 'unreadCount']) && addingSelf && resource.data.isPublic == true;
      }

      function isLeavingGroup() {
        let diff = request.resource.data.diff(resource.data);
        let removingSelf = resource.data.memberIds.hasAll(request.resource.data.memberIds)
                           && !(request.auth.uid in request.resource.data.memberIds);
        return diff.affectedKeys().hasAny(['memberIds']) && 
               diff.affectedKeys().hasOnly(['memberIds', 'activeMembers', 'adminIds', 'lastMessage', 'lastMessageSenderId', 'lastMessageAt']) && 
               removingSelf;
      }

      function isMemberUpdatingStats() {
        let diff = request.resource.data.diff(resource.data);
        return isGroupMember() && diff.affectedKeys().hasOnly([
          'lastMessage', 'lastMessageSenderId', 'lastMessageAt', 'unreadCount', 'updatedAt'
        ]);
      }

      allow update: if isGroupAdmin() || isLeavingGroup() || isMemberUpdatingStats() || isJoiningGroup();
      allow delete: if isGroupOwner();

      function getGroupData() {
        return exists(/databases/$(database)/documents/groups/$(groupId))
          ? get(/databases/$(database)/documents/groups/$(groupId)).data
          : getAfter(/databases/$(database)/documents/groups/$(groupId)).data;
      }

      match /members/{userId} {
        allow read: if signedIn() && request.auth.uid in getGroupData().memberIds;
        allow write: if signedIn() && (
          getGroupData().ownerId == request.auth.uid ||
          request.auth.uid in getGroupData().adminIds ||
          request.auth.uid == userId
        );
        allow create: if signedIn() && (
          getAfter(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid ||
          request.auth.uid == userId
        );
      }

      match /messages/{msgId} {
        allow read: if signedIn() && request.auth.uid in getGroupData().memberIds;
        allow create: if signedIn() && (
          (request.resource.data.senderId == request.auth.uid && request.auth.uid in getGroupData().memberIds) ||
          (request.resource.data.messageType == 'system' && request.resource.data.senderId == request.auth.uid &&
           getAfter(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid)
        );
        allow update: if signedIn() && (
          resource.data.senderId == request.auth.uid ||
          request.auth.uid in getGroupData().adminIds ||
          request.auth.uid == getGroupData().ownerId ||
          (
            request.auth.uid in getGroupData().memberIds &&
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'seenBy', 'deliveredTo', 'reactions', 'deletedForMe'
            ])
          )
        );
        allow delete: if signedIn() && (
          resource.data.senderId == request.auth.uid ||
          request.auth.uid in getGroupData().adminIds ||
          request.auth.uid == getGroupData().ownerId
        );
      }

      match /typing/{userId} {
        allow read: if signedIn() && request.auth.uid in getGroupData().memberIds;
        allow write: if signedIn() && (
          request.auth.uid == userId ||
          getGroupData().ownerId == request.auth.uid ||
          request.auth.uid in getGroupData().adminIds
        );
      }
    }

    // ── Direct Conversations ─────────────────────────────────────────────────
    match /conversations/{convId} {
      function isParticipant() {
        return signedIn() && request.auth.uid in resource.data.participantIds;
      }

      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.participantIds);
      allow list: if signedIn();
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update, delete: if isParticipant();

      match /messages/{msgId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;
        allow create: if signedIn() && request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;
        allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
        allow update: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds &&
          (
            request.resource.data.diff(resource.data).changedKeys().hasOnly(['isRead', 'status']) ||
            request.resource.data.diff(resource.data).changedKeys().hasOnly(['deletedForMe']) ||
            request.resource.data.diff(resource.data).changedKeys().hasOnly(['reactions']) ||
            (resource.data.senderId == request.auth.uid && request.resource.data.diff(resource.data).changedKeys().hasOnly(['text', 'isEdited', 'editedAt'])) ||
            (resource.data.senderId == request.auth.uid && request.resource.data.diff(resource.data).changedKeys().hasOnly(['deletedForAll', 'text', 'mediaUrls', 'audioUrl']))
          );
      }

      match /typing/{userId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;
        allow write: if signedIn() && request.auth.uid == userId;
      }
    }

    // ── Group Invites (Secured) ──────────────────────────────────────────────
    match /group_invites/{inviteToken} {
      // Allow any authenticated user to resolve/read the token when scanning
      allow read: if signedIn();
      
      // Only group admins or owners can create tokens for a group
      allow create: if signedIn() && 
        (
          request.resource.data.creatorId == request.auth.uid &&
          (
            request.auth.uid == get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.ownerId ||
            request.auth.uid in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.adminIds
          )
        );

      // Only invite creator or group admins can revoke it.
      // Alternatively, the joiner can increment the use count by exactly 1.
      allow update: if signedIn() && (
        (
          resource.data.creatorId == request.auth.uid ||
          request.auth.uid == get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.ownerId
        ) || (
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['useCount']) &&
          request.resource.data.useCount == resource.data.useCount + 1
        )
      );
      
      allow delete: if signedIn() && (
        resource.data.creatorId == request.auth.uid ||
        request.auth.uid == get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.ownerId
      );
    }

    // ── Group Join Requests (Secured) ────────────────────────────────────────
    match /group_join_requests/{requestId} {
      // Users can read their own request; group admins can read requests for their group
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        request.auth.uid == get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.ownerId ||
        request.auth.uid in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.adminIds
      );

      // Anyone can request to join under their own UID, status MUST start as 'pending'
      allow create: if signedIn() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';

      // Requesters cannot approve themselves. Status update requires group admin privileges.
      allow update: if signedIn() && (
        (
          request.auth.uid == get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.ownerId ||
          request.auth.uid in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.adminIds
        ) && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status'])
      );

      allow delete: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        request.auth.uid == get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.ownerId
      );
    }
    
    // ── Collection Group Query (Members) ─────────────────────────────────────
    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        memberId == request.auth.uid
      );
    }
  }
}
