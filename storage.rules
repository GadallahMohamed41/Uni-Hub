rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // PDF Certificates (Strict validation: PDF only, max 10MB)
    match /users/{userId}/certificates/{fileName} {
      allow read: if signedIn() && (isOwner(userId) || request.auth.token.role == 'admin');
<<<<<<< HEAD
